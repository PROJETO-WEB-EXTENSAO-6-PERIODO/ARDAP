# desenvolvimento ou producao
AMBIENTE=desenvolvimento

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ardap
# true nos bancos da nuvem (obrigatorio em producao)
DB_SSL=false
# caminho do certificado, so se o provedor usar uma CA propria
DB_SSL_CA=

# obrigatoria, ao menos 32 caracteres. Gere com:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=480

# enderecos do frontend, separados por virgula
CORS_ORIGINS=http://localhost:5173

# Cloudflare R2 (obrigatorio em producao; vazio usa Backend/uploads)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
