# Copie para Backend/.env (API) e Frontend/.env (site) e preencha com os valores reais.
# Os arquivos .env nao vao para o GitHub (.gitignore).
# Lista completa e comentada: Backend/.env.example e Frontend/.env.example.

# --- API (Backend/.env) ---
AMBIENTE=desenvolvimento
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ardap
SECRET_KEY=
CORS_ORIGINS=http://localhost:5173

# Modelo de IA (vazio = ai-model/models/modelo.joblib)
IA_MODELO_PATH=
IA_METRICAS_PATH=

# --- Site (Frontend/.env) ---
VITE_API_URL=http://localhost:8000
